# Port service (samakan dengan WA_SERVICE_URL di .env Laravel)
PORT=3001

# Token rahasia (samakan dengan WA_SERVICE_TOKEN di .env Laravel)
WA_TOKEN=ganti-dengan-token-acak-panjang

# Folder sesi login WhatsApp (kosong = ./sesi)
# FOLDER_SESI=./sesi

# Jeda antar pesan (detik) untuk mengurangi risiko diblokir
JEDA_MIN=4
JEDA_MAKS=9

# Batas pesan per jam
MAKS_PER_JAM=40
