APP_NAME="Billing Rental PS"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL={{APP_URL}}
APP_MODE=local
APP_TIMEZONE={{ZONA}}
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Data (unggahan, sesi, log, backup) di luar folder program: aman saat update & bisa disimpan saat uninstall
LARAVEL_STORAGE_PATH="{{DATA}}/storage"

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT={{PORT_DB}}
DB_DATABASE=billing_ps
DB_USERNAME=billing
DB_PASSWORD={{DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

REVERB_APP_ID={{REVERB_ID}}
REVERB_APP_KEY={{REVERB_KEY}}
REVERB_APP_SECRET={{REVERB_SECRET}}
REVERB_HOST=127.0.0.1
REVERB_PORT={{PORT_WS}}
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT={{PORT_WS}}

# TV di LAN: host = alamat yang dipakai TV memanggil API; port realtime
TV_WS_PORT={{PORT_WS}}
TV_WS_SCHEME=http

# Di belakang Cloudflare Tunnel / reverse proxy: 127.0.0.1,::1
TRUSTED_PROXIES=
